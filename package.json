{
  "name": "monte-vinhedo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "assets": "python scripts/prepare-assets.py",
    "shots": "node scripts/shoot.mjs && node scripts/shoot.mjs --mobile",
    "checks": "node scripts/checks.mjs",
    "audit": "lighthouse http://localhost:4173/ --view --chrome-flags=\"--headless=new\"",
    "telas": "node scripts/telas.mjs",
    "abertura": "node scripts/abertura.mjs",
    "profundidade": "node scripts/profundidade.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
